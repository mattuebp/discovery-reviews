# Real secret key for the Anthropic (Claude) API — used in the "enrich" pipeline
# stage to label review theme/sentiment. Get one at https://console.anthropic.com/
# Copy this file to `.env` and fill in the real value there; `.env` is git-ignored
# and must never be committed.
ANTHROPIC_API_KEY=

# Secret "pepper" mixed into the author_hash calculation (the "normalize"
# pipeline stage). Without this salt, someone could still guess a raw
# reviewer name and check it against every stored hash (a "rainbow table"
# attack) — mixing in a secret value nobody outside this project knows
# closes that gap, so the PII policy in docs/governanca.md actually holds.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUTHOR_HASH_SALT=
